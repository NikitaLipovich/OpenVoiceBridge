// Copy to plat_secrets.h (git ignores it) and fill in. Without it U3 builds, starts no Wi-Fi and refuses every update
// from the network; it can then only be flashed over USB. docs: lyrat_resend/docs/PLATFORM_OTA.md.
#pragma once
#define WIFI_SSID  "your-network"
#define WIFI_PASS  "your-password"
// At least 16 random characters; platform_ota.py reads it from here or from BENCH_OTA_TOKEN.
#define OTA_TOKEN  "change-me-16-chars-or-more"
