<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.openvoicebridge.scoprobe">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets the app read the name of the Bluetooth audio device it is about to route to. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The "Стенд" screen (goal 104) talks to benchd on the PC over the home Wi-Fi, plain HTTP with a token. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Goal 105: the screen follows the Wi-Fi (NetworkCallback) and ties its sockets to it; a normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application android:label="SCO Probe" android:allowBackup="false" android:usesCleartextTraffic="true">
        <!-- singleTask: a repeated `am start` lands in onNewIntent of the same activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|density|fontScale|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Not exported: opened by the button of MainActivity or the probe command "bench" (am start, extra cmd=bench). -->
        <activity
            android:name=".BenchActivity"
            android:exported="false"
            android:label="Стенд"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|density|fontScale|locale" />
    </application>
</manifest>
