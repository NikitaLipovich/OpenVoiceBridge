{
 "spec_version": 1,
 "schema": "bench_ui_spec.md",
 "title": "Стенд",
 "owner": "owner",
 "poll_ms": {"status": 2000, "job": 2000},
 "texts": {
  "no_service": "служба не отвечает",
  "updated": "обновлено {$time}",
  "lock_other": "Стенд сейчас держит «{lock.holder.owner}». Сделать это поверх его замка? Это может испортить его измерение.",
  "job_started": "задание {id} запущено",
  "job_state": "задание {id} {kind}: {$state}",
  "job_running": "идёт",
  "job_ended": "закончено, код {exit}",
  "done": "готово: {$json}",
  "refused": "отказ ({$code}): {error}",
  "unknown_route": "служба benchd старее пульта: нет {$route}",
  "busy": "…",
  "direct_header": "напрямую с S3 {s3.addr}: ПК не найден, замка нет — команды идут мимо службы",
  "direct_unavailable": "только через службу на ПК: ПК сейчас не найден",
  "direct_done": "готово (напрямую): {$reply}",
  "direct_failed": "S3 не ответила: {$why}",
  "direct_pc_back": "ПК снова доступен — команда не послана, повторите через службу"
 },
 "header": "служба: pid {benchd.pid}, работает {benchd.up_s|int} с, строк {benchd.counts.lines}, диск {benchd.disk.log_bytes|mb1} МБ из {benchd.disk.limit_bytes|mb0}",
 "panels": [
  {
   "id": "boards",
   "title": "Платы",
   "via": ["benchd", "s3-direct"],
   "fields": [
    {"id": "s3", "label": "S3", "cases": [
     {"if": [{"path": "s3.found", "op": "falsy"}], "text": "не найдена", "color": "bad"},
     {"if": [{"path": "s3.lost", "op": "truthy"}], "text": "ПРОПАЛА", "color": "bad"},
     {"text": "на связи", "color": "ok"}]},
    {"id": "s3_addr", "label": "S3 адрес / boot / аптайм", "cases": [
     {"text": "{s3.addr} / {s3.boot} / {s3.up_s} с"}]},
    {"id": "s3_wifi", "label": "S3 Wi-Fi rssi / txp / версия", "cases": [
     {"if": [{"path": "s3.rssi", "op": "le", "value": -80}], "text": "{s3.rssi} дБм / {s3.txp} / {s3.ver}", "color": "bad"},
     {"if": [{"path": "s3.rssi", "op": "le", "value": -70}], "text": "{s3.rssi} дБм / {s3.txp} / {s3.ver}", "color": "warn"},
     {"text": "{s3.rssi} дБм / {s3.txp} / {s3.ver}"}]},
    {"id": "lyrat", "label": "LyraT", "cases": [
     {"if": [{"path": "lyrat.lost", "op": "truthy"}], "text": "ПРОПАЛА", "color": "bad"},
     {"text": "на связи", "color": "ok"}]},
    {"id": "lyrat_up", "label": "LyraT аптайм / последний кадр", "cases": [
     {"text": "{lyrat.up_s} с / {lyrat.last_frame_ms} мс"}]},
    {"id": "sco", "label": "Канал гарнитуры (SCO)", "cases": [
     {"if": [{"path": "lyrat.sco_open", "op": "truthy"}], "text": "открыт", "color": "warn"},
     {"text": "закрыт"}]},
    {"id": "mic", "label": "Микрофон LyraT (кнопка Rec)", "cases": [
     {"if": [{"path": "lyrat.mic_muted", "op": "truthy"}], "text": "ВЫКЛЮЧЕН — собеседник вас не слышит", "color": "bad"},
     {"if": [{"path": "lyrat.mic_muted", "op": "eq", "value": false}], "text": "включён", "color": "ok"},
     {"text": "—"}]},
    {"id": "lyrat_ver", "label": "LyraT версия", "cases": [
     {"text": "{lyrat.ver}"}]},
    {"id": "phone", "label": "Телефон (только чтение)", "via": ["benchd"], "cases": [
     {"if": [{"path": "phone.state", "op": "falsy"}], "text": "—"},
     {"text": "{phone.state}{phone.model|opt_comma}"}]}
   ]
  },
  {
   "id": "lock",
   "title": "Замок и задания",
   "fields": [
    {"id": "lock", "label": "Замок", "cases": [
     {"if": [{"path": "lock.holder", "op": "truthy"}],
      "text": "у «{lock.holder.owner}» до {lock.holder.until|hhmm} ({lock.holder.left_s|int} с){lock.holder.note|opt_comma}",
      "color": "warn"},
     {"text": "свободен", "color": "ok"}]},
    {"id": "queue", "label": "Очередь", "cases": [
     {"if": [{"path": "lock.queue", "op": "empty"}], "text": "пусто"},
     {"text": "{lock.queue|owners}"}]},
    {"id": "lan", "label": "Управление из сети", "cases": [
     {"if": [{"path": "lan.control", "op": "truthy"}], "text": "включено (с токеном)", "color": "warn"},
     {"if": [{"path": "lan.listen", "op": "truthy"}], "text": "только чтение"},
     {"text": "выключено"}]},
    {"id": "jobs", "list": "jobs", "label": "задание {id}", "cases": [
     {"text": "{kind} ({owner}) идёт", "color": "warn"}]}
   ],
   "actions": "lock"
  },
  {
   "id": "actions",
   "title": "Действия",
   "via": ["benchd", "s3-direct"],
   "fields": [],
   "actions": "bench",
   "results": true
  }
 ],
 "actions": [
  {"id": "take", "label": "Взять стенд себе (1 ч)", "group": "lock", "row": 1,
   "method": "POST", "endpoint": "/lock", "body": {"ttl_s": 3600, "note": "владелец ({$device})"},
   "confirm": "Взять стенд себе на 1 час? Гоалы будут ждать.",
   "lan_control": true, "requires_lock": false, "danger": false,
   "result": {"ok": [{"text": "стенд ваш на 1 час"}], "fail": [{"text": "не взят: {error}"}]}},
  {"id": "renew", "label": "Продлить мой замок (1 ч)", "group": "lock", "row": 1,
   "method": "POST", "endpoint": "/lock/renew", "body": {"ttl_s": 3600},
   "available_if": [{"path": "lock.holder.owner", "op": "eq", "value": "owner"}],
   "unavailable_text": "замок не ваш: сначала возьмите стенд",
   "lan_control": true, "requires_lock": false, "danger": false,
   "result": {"ok": [{"text": "замок продлён, осталось {left_s|int} с"}], "fail": [{"text": "нет: {error}"}]}},
  {"id": "give", "label": "Отдать мой замок", "group": "lock", "row": 1,
   "method": "POST", "endpoint": "/lock/release", "body": {},
   "lan_control": true, "requires_lock": false, "danger": false,
   "result": {"ok": [{"if": [{"path": "released", "op": "truthy"}], "text": "замок отдан"},
                     {"text": "замок и так был свободен"}],
              "fail": [{"text": "нет: {error}"}]}},
  {"id": "steal", "label": "Снять чужой замок", "group": "lock", "row": 1,
   "method": "POST", "endpoint": "/lock/release", "body": {"force": true},
   "available_if": [{"path": "lock.holder", "op": "truthy"}], "unavailable_text": "замок свободен",
   "confirm": "Снять замок «{lock.holder.owner}»?", "confirm2": "Его окно или прошивка могут сломаться. Точно снять?",
   "lan_control": true, "requires_lock": false, "danger": true,
   "result": {"ok": [{"text": "замок снят"}], "fail": [{"text": "нет: {error}"}]}},
  {"id": "mic_off", "label": "Выключить микрофон", "group": "bench", "row": 0,
   "method": "POST", "endpoint": "/action", "body": {"name": "mic_mute", "mode": "on"},
   "available_if": [{"path": "lyrat.mic_muted", "op": "ne", "value": true}], "unavailable_text": "микрофон уже выключен",
   "lan_control": true, "requires_lock": true, "danger": false,
   "via": ["benchd", "s3-direct"], "direct": {"op": "uc", "text": "mute on"}},
  {"id": "mic_on", "label": "Включить микрофон", "group": "bench", "row": 0,
   "method": "POST", "endpoint": "/action", "body": {"name": "mic_mute", "mode": "off"},
   "available_if": [{"path": "lyrat.mic_muted", "op": "ne", "value": false}], "unavailable_text": "микрофон уже включён",
   "lan_control": true, "requires_lock": true, "danger": false,
   "via": ["benchd", "s3-direct"], "direct": {"op": "uc", "text": "mute off"}},
  {"id": "reboot_lyrat", "label": "Перезапуск LyraT", "group": "bench", "row": 1,
   "method": "POST", "endpoint": "/action", "body": {"name": "reboot_lyrat"},
   "confirm": "Точно перезапустить LyraT?", "lan_control": true, "requires_lock": true, "danger": true,
   "via": ["benchd", "s3-direct"], "direct": {"op": "uc", "text": "reboot 1"}},
  {"id": "restart_s3", "label": "Перезапуск S3", "group": "bench", "row": 1,
   "method": "POST", "endpoint": "/action", "body": {"name": "restart_s3"},
   "confirm": "Точно перезапустить S3?", "lan_control": true, "requires_lock": true, "danger": true,
   "via": ["benchd", "s3-direct"], "direct": {"op": "ux"}},
  {"id": "bt_mode", "label": "Режим BT", "group": "bench", "row": 1,
   "method": "POST", "endpoint": "/action", "body": {"name": "bt_mode"},
   "params": [{"name": "mode", "label": "режим", "type": "text", "default": "", "placeholder": "режим"}],
   "visible_if": [{"path": "bt_mode", "op": "truthy"}],
   "confirm": "Точно сменить режим Bluetooth на «{$param.mode}»?", "lan_control": true, "requires_lock": true, "danger": true},
  {"id": "flash_both", "label": "Прошить обе платы", "group": "bench", "row": 2,
   "method": "POST", "endpoint": "/action", "body": {"name": "flash_both"},
   "confirm": "Точно прошить обе платы (fw.py flash --board both)?", "lan_control": true, "requires_lock": true, "danger": true,
   "direct_unavailable": "прошивка — только через службу на ПК: образы лежат на ПК"},
  {"id": "call_probe", "label": "call_check --probe 1", "group": "bench", "row": 2,
   "method": "POST", "endpoint": "/action", "body": {"name": "call_probe"},
   "confirm": "Точно запустить call_check --probe 1 (без звонка)?", "lan_control": true, "requires_lock": true, "danger": true},
  {"id": "ota", "label": "Прошить плату", "group": "bench", "row": 3,
   "method": "POST", "endpoint": "/ota", "body": {},
   "params": [{"name": "board", "label": "плата", "type": "enum", "choices": [["lyrat", "LyraT"], ["s3", "S3"]], "default": "lyrat"},
              {"name": "via", "label": "путь", "type": "enum", "choices": [["auto", "сам выберет"], ["wifi", "Wi-Fi"], ["uart", "UART"]], "default": "auto"}],
   "confirm": "Точно прошить {$param.board} (fw.py flash, путь {$param.via})?", "lan_control": true, "requires_lock": true, "danger": true,
   "direct_unavailable": "прошивка — только через службу на ПК: образы лежат на ПК"},
  {"id": "cmd", "label": "Команда консоли", "group": "bench", "row": 4,
   "method": "POST", "endpoint": "/cmd", "body": {},
   "params": [{"name": "target", "label": "плата", "type": "enum", "choices": [["lyrat", "LyraT"], ["s3", "S3"]], "default": "lyrat"},
              {"name": "cmd", "label": "команда", "type": "text", "default": "", "placeholder": "s, bod, query…"}],
   "confirm": "Послать «{$param.cmd}» на {$param.target}?", "lan_control": true, "requires_lock": true, "danger": true,
   "via": ["benchd", "s3-direct"], "direct": {"op": "cmd"}}
 ],
 "feeds": [
  {"id": "events", "kind": "events", "title": "События", "method": "GET", "endpoint": "/events", "poll_ms": 5000,
   "params": [{"name": "from", "label": "за", "type": "enum",
               "choices": [["-10m", "10 мин"], ["-1h", "час"], ["-6h", "6 часов"], ["-1d", "сутки"]], "default": "-1h"},
              {"name": "type", "label": "тип", "type": "text", "default": "", "placeholder": "тип: boot,slc_down…"}],
   "fixed": {"limit": 500},
   "columns": ["время", "тип", "плата", "подробности"],
   "hide_keys": ["t", "type", "board", "board_t_s"],
   "bad": "lost|down|panic|fail|rollback|bod|gap|expired|overridden"},
  {"id": "log", "kind": "tail", "title": "Лог", "via": ["benchd", "s3-direct"], "method": "GET", "endpoint": "/tail", "poll_ms": 1000,
   "params": [{"name": "board", "label": "плата", "type": "enum", "choices": [["", "обе платы"], ["lyrat", "LyraT"], ["s3", "S3"]], "default": ""},
              {"name": "grep", "label": "фильтр", "type": "text", "default": "", "placeholder": "фильтр (регулярное выражение)"}],
   "cursor": "after", "limit_param": "limit", "first_limit": 200, "limit": 500, "keep": 2000}
 ]
}
