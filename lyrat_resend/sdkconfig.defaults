# ESP32 LyraT — BT Classic (HFP + A2DP) defaults
# Применяется при: idf.py set-target esp32

# ── Bluetooth стек ──────────────────────────────────────────────────────────
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SSP_ENABLED=y

# A2DP (Bluetooth аудио профиль — приём музыки)
CONFIG_BT_A2DP_ENABLE=y

# HFP Hands-Free Unit (гарнитура / телефон)
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y

# The application gets raw frames with their status: the old path loses the status of a CVSD frame, so a loss cannot be
# concealed. The SBC code stays inside the bt component only because A2DP above keeps its internal codec. See main/msbc_codec.c.
CONFIG_BT_HFP_USE_EXTERNAL_CODEC=y

# Аудио datapath: HCI (программный, через esp_hf_client_outgoing_data_cb_t)
# PCM hardware datapath НЕВОЗМОЖЕН на LyraT v4.3:
#   GPIO0 (PCM CLK)  = занят MCLK  для ES8388 I2S
#   GPIO5 (PCM DIN)  = занят BCLK  для ES8388 I2S
#   GPIO25 (PCM SYNC)= занят LRCLK для ES8388 I2S
#   GPIO4 (PCM DOUT) = занят MicroSD D1
# Официальный ADF пример pipeline_a2dp_sink_and_hfp использует HCI по той же причине.
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y

# ── BTDM контроллер ─────────────────────────────────────────────────────────
# BR/EDR only — BLE не нужен, экономит ~50KB heap + IRAM
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
# SCO/eSCO соединений (для звонков достаточно 1)
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1

# ── Bluetooth only ───────────────────────────────────────────────────────────
# No Wi-Fi on this board since goal 044, so no radio to share: the arbiter stays out.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

# ── PSRAM BSS ────────────────────────────────────────────────────────────────
# Allow EXT_RAM_BSS_ATTR to place static buffers in PSRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ── Brownout ─────────────────────────────────────────────────────────────────
# Radio start draws peak current — USB power can sag and trigger brownout reset.
# Disable detector to prevent boot loops on marginal USB power.
CONFIG_ESP_BROWNOUT_DET=n

# ── FreeRTOS ─────────────────────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
# The command "cpu": the load of every task with the channel open.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# ── Flash и таблица разделов ─────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partitions: nvs (24K, same place as before), otadata, phy, two app slots of 1984K for updates through the S3 with
# rollback (docs/OTA.md). The old table with one factory slot is partitions_bt_sink_example.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# With rollback the bootloader at INFO leaves 2 % of its 28K before the table; WARN leaves 10 % (goal 090 #001).
# The bench reads only the ROM's "rst:" lines, not the bootloader's.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# PHY: the radio start pulled the chip supply below 2.8 V at 20 dBm (goal 010 RESULTS). The cap also
# bounds the start calibration, which runs without Wi-Fi too, so it stays. See goal 044 for the sag now.
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10
