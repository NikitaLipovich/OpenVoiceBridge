// Copy to ota_secrets.h (git ignores it): the Wi-Fi network (2.4 GHz, the same network as the PC) and a token of at least
// 16 random characters.
// ota.py reads it from the same file, or from BENCH_OTA_TOKEN. Without the file every update over the network is refused.
#pragma once

#define OTA_TOKEN "CHANGE-ME-16-or-more-random-chars"

#define WIFI_SSID "your-2.4-GHz-network"
#define WIFI_PASS "your-password"
// Optional: cap of the Wi-Fi transmit power in 0.25 dBm (8..84), e.g. 40 = 10 dBm; leave out for the default.
// #define WIFI_MAX_TX_QDBM 40
